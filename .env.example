# Absolute path to the local clone of the repository the pipeline works on
TARGET_REPO_PATH=C:\Projects\reading_list
# Code findings at or above this severity block a change: LOW, MEDIUM or HIGH
BLOCKING_SEVERITY=MEDIUM
# Branches the pipeline may never push to
PROTECTED_BRANCHES=main,master
# Branch that changes are compared against
BASE_BRANCH=main
# Where outcome notifications are written
NOTIFICATIONS_LOG=runs/notifications.log
# Ollama model the agents run on
MODEL_NAME=gemma4:e4b
# Context window given to the model, in tokens
NUM_CTX=8192
# Implementer: attempts before stopping as blocked, and tool calls allowed per attempt
MAX_ATTEMPTS=3
MAX_TOOL_STEPS=12
# Folder for the throwaway worktree the fail-first check runs new tests in
FAIL_FIRST_WORKTREE=runs/fail_first_worktree
# Folder that generated task folders (one per run) are written under
TASKS_PATH=runs/tasks
# Spec and test author: revisions allowed after the first attempt before stopping
MAX_AUTHOR_REVISIONS=2
# Review gate: reviews before stopping as blocked, counting the first one
MAX_REVIEW_ROUNDS=2
