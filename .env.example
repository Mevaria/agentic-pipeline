# Absolute path to the local clone of the repository the pipeline works on
TARGET_REPO_PATH=C:\Projects\reading_list
# Code findings at or above this severity block a change: LOW, MEDIUM or HIGH
BLOCKING_SEVERITY=MEDIUM
# Branches the pipeline may never push to
PROTECTED_BRANCHES=main,master
# Branch that changes are compared against
BASE_BRANCH=main
# Where outcome notifications are written
NOTIFICATIONS_LOG=runs/notifications.log
# Ollama model the agents run on
MODEL_NAME=gemma4:e4b
# Context window given to the model, in tokens
NUM_CTX=8192
# Implementer: attempts before stopping as blocked, and tool calls allowed per attempt
MAX_ATTEMPTS=3
MAX_TOOL_STEPS=12
# Folder for the throwaway worktree the fail-first check runs new tests in
FAIL_FIRST_WORKTREE=runs/fail_first_worktree
# Folder that generated task folders (one per run) are written under
TASKS_PATH=runs/tasks
# Spec and test author: revisions allowed after the first attempt before stopping
MAX_AUTHOR_REVISIONS=2
# Review gate: reviews before stopping as blocked, counting the first one
MAX_REVIEW_ROUNDS=2
# Reviewer: run a second, security-only model call after the review (1 to enable)
SECURITY_PASS=0
# Path to the official GitHub MCP server binary (github-mcp-server.exe), used by the reporter
GITHUB_MCP_SERVER=C:\path\to\github-mcp-server.exe
# Fine-grained token scoped to the target repository: Pull requests read and write, Metadata read
GITHUB_PERSONAL_ACCESS_TOKEN=
# Where the reporter writes one JSON record per run
RECORDS_PATH=runs/records
# Feedback loop: /revise comments acted on per pull request before stopping
MAX_PR_REVISIONS=2
# Chroma MCP server (installed in its own .venv-chroma) and where its persistent data lives
CHROMA_MCP_SERVER=.venv-chroma\Scripts\chroma-mcp.exe
CHROMA_DATA_PATH=runs/chroma
# Memory: past runs under this cosine distance are shown to the author; under the second one an open PR counts as a duplicate
MEMORY_DISTANCE_THRESHOLD=0.40
MEMORY_DUPLICATE_THRESHOLD=0.20
# Reviewer over A2A: set to the service started by "python -m pipeline.serve_reviewer" to review remotely; empty means in-process
REVIEWER_A2A_URL=
